{
	"name": "hamverbot",
	"private": true,
	"type": "module",
	"module": "index.ts",
	"scripts": {
		"start": "bun run src/index.ts",
		"build": "bun build src/index.ts --minify --target bun --outfile hamverbot.ts",
		"schema:sync": "bun run scripts/sync-turso-schema.ts",
		"test": "bun test",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"check": "bun run typecheck && bun run format:check && bun run lint"
	},
	"dependencies": {
		"@libsql/client": "^0.17.3",
		"@microsoft/signalr": "^10.0.0",
		"cron": "^4.4.0",
		"dotenv": "^17.4.2",
		"irc-framework": "^4.14.0",
		"node-ical": "^0.26.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"oxlint-tsgolint": "^0.24.0",
		"typescript": "^7.0.2"
	}
}
